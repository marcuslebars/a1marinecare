# Google Places API Configuration
# Get API key from Google Cloud Console > APIs & Services > Credentials
# Enable "Places API" for your project
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Business Profile Place ID
# Use the lookup script to find your Place ID:
#   npm run lookup:place-id
#
# The script queries Google Places API by business name + location
# to retrieve the correct Place ID (format: ChIJ...).
#
# Alternatively find manually at:
# https://developers.google.com/maps/documentation/places/web-service-place-id
GOOGLE_PLACE_ID=your-google-place-id

# Google Calendar API Configuration
# Get OAuth credentials from Google Cloud Console > APIs & Services > Credentials
# Enable "Google Calendar API" for your project
# Set up OAuth 2.0 client ID (Web application type) and configure redirect URI
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/google/oauth/callback

# OAuth refresh token obtained via the OAuth flow
# This is used to authenticate calendar API requests
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Google Calendar ID to create events in
# Use "primary" for the user's primary calendar, or a specific calendar ID (email address or calendar ID)
# Default if not set: "primary"
GOOGLE_CALENDAR_ID=primary

# Gemini API Configuration
# Get API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model for boat preview image generation
# Default: gemini-3.1-flash-image-preview
# Allowed alternatives: gemini-2.5-flash-image, gemini-3-pro-image-preview
# Note: gemini-2.0-flash-preview-image-generation and gemini-1.5-flash are not valid here
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Gemini model for condition report analysis (text JSON output)
# Default: gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Admin Dashboard Password
# Required to access /admin/leads and /api/admin/test-email
# Default if not set: "a1marinecare2024"
ADMIN_DASHBOARD_PASSWORD=your-admin-password

# Email Configuration (Resend)
# RESEND_API_KEY: Get from https://resend.com/api-keys
# FROM_EMAIL: Must be a verified domain in Resend (e.g. noreply@yourdomain.com)
# CONTACT_TO_EMAIL: Destination for contact form and booking notification emails
RESEND_API_KEY=your-resend-api-key

# Sender address - MUST use a Resend-verified domain (not @resend.dev)
# Example: noreply@a1marinecare.ca, contact@a1marinecare.ca, bookings@a1marinecare.ca
FROM_EMAIL=A1 Marine Care <noreply@a1marinecare.ca>

# Destination email for all notifications
CONTACT_TO_EMAIL=contact@a1marinecare.ca

# CRM Webhook Configuration
# URL of the A1 Marine Care CRM — do not include a trailing slash
CRM_WEBHOOK_URL=https://leads.a1marinecare.ca
# Shared secret to authenticate webhook requests (must match WEBHOOK_SECRET in the CRM Railway service)
CRM_WEBHOOK_SECRET=your-crm-webhook-secret

# Meta (Facebook) Pixel — public client-side id. Defaults to the pixel that ran
# on a1marinestorage.ca (so its audiences carry over). Override to use a
# Marine Care-specific pixel.
NEXT_PUBLIC_META_PIXEL_ID=2437586250097446

# Stripe — $250 booking deposit on the shrink-wrap quote (Checkout Sessions).
# Webhook endpoint: POST /api/stripe/webhook, events checkout.session.completed
# + checkout.session.async_payment_succeeded. Leave unset to hide the deposit
# button (the quote flow still works without it).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional override, in cents (default 25000 = $250).
# SHRINK_WRAP_DEPOSIT_CENTS=25000

# Microsoft Clarity heatmaps + session recordings (public project id).
NEXT_PUBLIC_CLARITY_ID=yn66peioqe
